# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# archives — these have held copies of .env
*.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
.gstack/

.vercel

# Claude Code worktrees and temp files
/.claude/worktrees/
/.claude/settings.local.json

# Supabase temp files
/supabase/.temp/

# Screenshots and local images
*.png
!public/**/*.png

# wokwi-elements bundle: a dev-only input to the art harvest.
# The harvested output (lib/simulator/model/wokwi-art.generated.json) IS committed.
/public/vendor/

# toolchain archives downloaded by scripts/build-avr-hex.mjs
/.cache/

# Local production env dumps (contain live secrets)
.env.prod
.env.*.prod

# Vercel API token (local only, never commit)
.vercel-token
