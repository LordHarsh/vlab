# =============================================================================
# CLERK — https://dashboard.clerk.com  →  Your App  →  API Keys
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Clerk sends users. Must match the pages that exist in app/.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# =============================================================================
# SUPABASE — https://supabase.com/dashboard  →  Project Settings  →  API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# REQUIRED — not optional. Bypasses RLS; server-side only, never exposed to the
# browser. Three flows depend on it and fail without it:
#   - onboarding profile upsert   (lib/actions/profile.ts)
#   - class join-by-code lookup   (lib/actions/enrollment.ts)
#   - quiz grading + admin quiz editor, which read the answer-key columns that
#     migration 013 revoked from the `authenticated` role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# =============================================================================
# SETUP
# =============================================================================
#  1. cp .env.example .env  and fill in the values above.
#
#  2. Wire Clerk to Supabase (native third-party auth, not JWT templates):
#       Clerk dashboard    → Integrations → Supabase → activate
#       Supabase dashboard → Authentication → Third-Party Auth → add Clerk,
#                            paste your Clerk domain (your-app.clerk.accounts.dev)
#     RLS matches auth.jwt()->>'sub' against profiles.clerk_user_id, so this
#     integration is what makes every policy in the app work.
#
#  3. Run supabase/migrations/*.sql in numeric order in the SQL editor.
#
#  4. Sign up, complete onboarding, then promote yourself to admin:
#       update profiles set is_admin = true, approval_status = 'approved'
#       where email = 'you@example.com';
# =============================================================================
